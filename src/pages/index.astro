<script>
  // Handle Corporate RFQ form submit
  const rfqForm = document.getElementById('corporate-rfq-form') as HTMLFormElement;

  rfqForm?.addEventListener('submit', (e) => {
    e.preventDefault();

    const company = (document.getElementById('rfq-company') as HTMLInputElement).value;
    const person = (document.getElementById('rfq-person') as HTMLInputElement).value;
    const phone = (document.getElementById('rfq-phone') as HTMLInputElement).value;
    const location = (document.getElementById('rfq-location') as HTMLInputElement).value;
    const message = (document.getElementById('rfq-message') as HTMLTextAreaElement).value;

    const checkedServices: string[] = [];
    document.querySelectorAll('input[name="rfq-service"]:checked').forEach(el => {
      checkedServices.push((el as HTMLInputElement).value);
    });

    const servicesText = checkedServices.length > 0 ? checkedServices.join(', ') : 'General Engineering Consultation';

    // Format WhatsApp Message
    const text = `*Detect Fire Engineering BD - Corporate RFQ Request*%0A%0A` +
      `*Company:* ${encodeURIComponent(company)}%0A` +
      `*Contact Person:* ${encodeURIComponent(person)}%0A` +
      `*Phone:* ${encodeURIComponent(phone)}%0A` +
      `*Location:* ${encodeURIComponent(location)}%0A` +
      `*Required Services:* ${encodeURIComponent(servicesText)}%0A` +
      `*Project Scope:* ${encodeURIComponent(message || 'N/A')}%0A%0A` +
      `_Sent from Detect Fire Engineering BD Official Website_`;

    window.open(`https://wa.me/8801914457183?text=${text}`, '_blank');
  });
</script>
