---
import Layout from '../layouts/Layout.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';

const corporateServices = [
  {
    id: 'hydrant-sprinkler',
    title: 'Fire Hydrant & Automatic Sprinkler System',
    titleBn: 'ফায়ার হাইড্রেন্ট ও অটোমেটিক স্প্রিঙ্কলার সিস্টেম',
    subtitle: 'NFPA & BNBC 2020 Compliant Piping & Pump Rooms',
    icon: '💧',
    desc: 'Turnkey hydraulic design, pipe routing, jockey & main fire pump room installation, and flow testing for RMG, textile, and industrial manufacturing plants.',
    points: ['Jockey & Centrifugal Fire Pump Installation', 'UL/FM Listed Control Valves & Flow Switches', 'Civil Defense Certified Pressure Testing']
  },
  {
    id: 'detection-alarm',
    title: 'Central Addressable & Conventional Fire Alarm',
    titleBn: 'সেন্ট্রাল অ্যাড্রেসেবল ও কনভেনশনাল ফায়ার অ্যালার্ম',
    subtitle: 'Microprocessor-Controlled Intelligent Detection',
    icon: '🚨',
    desc: 'Multi-zone optical smoke detectors, rate-of-rise heat sensors, manual call points (break-glass units), repeater panels, and high-decibel industrial siren networks.',
    points: ['Loop-Powered Addressable Control Panels', 'Emergency Voice Evacuation & Public Address', '24/7 Battery Backup & Fault Self-Diagnosis']
  },
  {
    id: 'fire-license',
    title: 'Fire License Renewal & Civil Defense Compliance',
    titleBn: 'ফায়ার লাইসেন্স নবায়ন ও সিভিল ডিফেন্স কমপ্লায়েন্স',
    subtitle: '100% Legal & Regulatory Audit Support',
    icon: '📋',
    desc: 'Pre-audit safety assessments, escape route designing, fire fighting layout drawings, and direct liaison with Bangladesh Fire Service & Civil Defense Directorate.',
    points: ['Factory Safety Inspection & Gap Analysis', 'Emergency Exit Route & Photoluminescent Signage', 'Mock Fire Drill & Personnel Safety Training']
  },
  {
    id: 'refilling-hydro',
    title: 'Cylinder Bulk Refilling & Hydrostatic Testing',
    titleBn: 'সিলিন্ডার রিফিলিং ও হাইড্রোস্ট্যাটিক প্রেশার টেস্টিং',
    subtitle: '3kg & 5kg ABC Dry Powder, CO2 & Foam Agents',
    icon: '🧯',
    desc: 'Certified gas refill with genuine imported chemical powder, pressure gauge calibration, and hydraulic pressure shell integrity testing with formal certificates.',
    points: ['Factory Pick-Up & Return Logistics across BD', 'Official Hydro-Testing Safety Clearance Report', 'Brand-New Valve & Seal Replacements']
  },
  {
    id: 'amc-maintenance',
    title: 'Annual Maintenance Contracts (AMC)',
    subtitle: 'Zero-Downtime Year-Round Peace of Mind',
    icon: '🛠️',
    desc: 'Scheduled monthly engineer visits, fire pump auto-start trials, detector sensitivity checks, battery health audits, and priority emergency breakdown support.',
    points: ['Monthly Detailed Technical Audit Reports', '2-Hour Priority Emergency Breakdown Dispatch', 'Free Routine Labor & Discounted Spare Parts']
  },
  {
    id: 'industrial-ppe',
    title: 'Industrial Safety Gear & PPE Bulk Supply',
    subtitle: 'Certified Workforce Personal Protective Equipment',
    icon: '🦺',
    desc: 'International standard safety helmets, steel-toe anti-puncture shoes, heat-resistant fire gloves, and high-visibility 3M reflective vests for industrial plants.',
    points: ['EN & ANSI Certified Protective Gear', 'Corporate Bulk Wholesale Pricing for RMG', 'Immediate Warehouse Dispatch Nationwide']
  }
];

const projects = [
  {
    id: 'proj-1',
    title: 'Apex Textile & Garments Complex',
    location: 'Gazipur, Dhaka',
    category: 'Hydrant & Sprinkler',
    size: '450,000 Sq. Ft.',
    desc: 'Complete turnkey installation of wet riser hydrant system, 2,200 sprinkler heads, and a dedicated 1,500 GPM centrifugal pump room.',
    badge: 'Completed & Certified',
    metric: '100% Audit Clearance'
  },
  {
    id: 'proj-2',
    title: 'Square Pharma Logistics & Distribution Hub',
    location: 'Savar, Dhaka',
    category: 'Alarm & Detection',
    size: '280,000 Sq. Ft.',
    desc: 'Addressable 4-loop microprocessor fire alarm system with optical beam smoke detectors for 12-meter high-ceiling storage bays.',
    badge: 'NFPA Compliant',
    metric: '850+ Connected Sensors'
  },
  {
    id: 'proj-3',
    title: 'Crown Commercial Tower',
    location: 'Motijheel C/A, Dhaka',
    category: 'Compliance & Audit',
    size: '22-Story High-Rise',
    desc: 'Complete high-rise fire safety audit, evacuation route design, fire doors inspection, and Bangladesh Fire Service license renewal.',
    badge: 'Civil Defense Approved',
    metric: 'Annual License Granted'
  },
  {
    id: 'proj-4',
    title: 'Incepta Chemical & Hazardous Materials Storage',
    location: 'Narayanganj',
    category: 'Gas Suppression',
    size: '120,000 Sq. Ft.',
    desc: 'Automatic CO2 total flooding system with quick-discharge actuators and combustible gas leak detection sensors.',
    badge: 'Clean Agent Protection',
    metric: 'Zero Chemical Residue'
  },
  {
    id: 'proj-5',
    title: 'Bashundhara Corporate Headquarters & Complex',
    location: 'Bashundhara R/A, Dhaka',
    category: 'Equipment Deployment',
    size: 'Commercial Hub',
    desc: 'Deployment of 350+ units of 5kg ABC dry powder extinguishers, emergency escape masks, and photoluminescent wayfinding signs.',
    badge: 'Fully Operational',
    metric: '350+ Extinguishers'
  },
  {
    id: 'proj-6',
    title: 'KDS Garments & Logistics Facilities',
    location: 'Chattogram Port City',
    category: 'AMC & Maintenance',
    size: '3 Factory Units',
    desc: 'Comprehensive Annual Maintenance Contract (AMC) including quarterly hydrostatic cylinder testing and weekly pump trial runs.',
    badge: 'Ongoing AMC Contract',
    metric: '99.9% System Readiness'
  }
];

const industries = [
  { name: 'RMG & Textile Mills', desc: 'Full compliance for export garments & fabrics', icon: '🧵' },
  { name: 'Pharmaceuticals', desc: 'Cleanroom protection & chemical safety', icon: '💊' },
  { name: 'Warehouses & Logistics', desc: 'High-ceiling beam sensing & hydrants', icon: '📦' },
  { name: 'Commercial High-Rises', desc: 'Corporate towers & financial centers', icon: '🏢' },
  { name: 'Hospitals & Healthcare', desc: 'Early sensing & patient safe evacuation', icon: '🏥' },
  { name: 'Hotels & Food Industry', desc: 'Kitchen hood suppression & gas alarms', icon: '🍽️' }
];
---

<Layout 
  title="Detect Fire Engineering BD | Industrial Fire Safety & Turnkey Engineering"
  description="Bangladesh's trusted fire safety partner for RMG, factories, and commercial high-rises. Fire Hydrant, Automatic Sprinkler, Addressable Fire Alarm Panels, and Civil Defense Compliance."
>
  <AnnouncementBar />
  <Navbar />

  <!-- ================= 1. HERO SECTION ================= -->
  <section class="relative bg-gradient-to-b from-slate-50 via-white to-slate-100 dark:bg-gradient-to-br dark:from-slate-950 dark:via-slate-900 dark:to-slate-950 text-slate-800 dark:text-white overflow-hidden py-20 sm:py-28 border-b border-slate-200 dark:border-slate-800 transition-colors">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(220,38,38,0.12),rgba(255,255,255,0))] dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(220,38,38,0.25),rgba(255,255,255,0))]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left Hero Copy -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-100/80 dark:bg-red-950/70 border border-red-200 dark:border-red-500/40 text-red-600 dark:text-red-400 text-xs font-bold uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
            <span>Industrial & Corporate Fire Engineering</span>
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-slate-950 dark:text-white leading-tight tracking-tight">
            Bangladesh's Premier Partner in <span class="bg-gradient-to-r from-red-600 via-rose-500 to-amber-500 dark:from-red-500 dark:via-rose-400 dark:to-orange-400 bg-clip-text text-transparent">Industrial Fire Safety</span>
          </h1>

          <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
            Turnkey Fire Hydrant & Automatic Sprinkler Systems, Central Addressable Alarm Panels, Civil Defense Fire Licensing, and Annual Maintenance (AMC) for factories and commercial high-rises.
          </p>

          <!-- Core Stat Counters -->
          <div class="grid grid-cols-3 gap-4 pt-4 border-t border-slate-200 dark:border-slate-800/80 max-w-lg mx-auto lg:mx-0">
            <div>
              <div class="text-2xl sm:text-3xl font-black text-slate-950 dark:text-white">500+</div>
              <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Facilities Protected</div>
            </div>
            <div>
              <div class="text-2xl sm:text-3xl font-black text-red-600 dark:text-red-500">100%</div>
              <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Audit Clearance</div>
            </div>
            <div>
              <div class="text-2xl sm:text-3xl font-black text-slate-950 dark:text-white">24/7</div>
              <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Emergency Support</div>
            </div>
          </div>

          <!-- Hero Action Buttons -->
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-4">
            <a 
              href="#contact" 
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-700 hover:to-rose-700 text-white font-bold text-base px-8 py-4 rounded-xl shadow-xl shadow-red-600/20 dark:shadow-red-950/40 transition transform hover:-translate-y-0.5"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span>Request Corporate RFQ</span>
            </a>

            <a 
              href="/store" 
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white hover:bg-slate-100 text-slate-800 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-200 dark:hover:text-white font-bold text-base px-6 py-4 rounded-xl border border-slate-200 dark:border-slate-700 transition shadow-sm"
            >
              <svg class="w-5 h-5 text-amber-500 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
              </svg>
              <span>Retail Online Shop</span>
            </a>
          </div>

        </div>

        <!-- Right Quick Corporate Hotline Card -->
        <div class="lg:col-span-5">
          <div class="bg-white/95 dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8 shadow-xl dark:shadow-2xl backdrop-blur-md relative overflow-hidden transition-colors">
            <div class="absolute -top-12 -right-12 w-40 h-40 bg-red-600/10 rounded-full blur-3xl pointer-events-none"></div>

            <div class="flex items-center gap-3.5 mb-6 pb-4 border-b border-slate-100 dark:border-slate-800">
              <div class="w-12 h-12 rounded-2xl bg-red-50 dark:bg-red-600/20 text-red-600 dark:text-red-500 border border-red-200 dark:border-red-500/30 flex items-center justify-center text-2xl font-bold">
                ⚡
              </div>
              <div>
                <h3 class="text-lg font-bold text-slate-900 dark:text-white">Direct Engineering Consultation</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">Speak directly with our Chief Safety Engineer</p>
              </div>
            </div>

            <div class="space-y-4">
              <a 
                href="tel:+8801914457183" 
                class="flex items-center justify-between p-4 rounded-2xl bg-slate-50 hover:bg-slate-100 dark:bg-slate-800/80 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700/80 transition group"
              >
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-red-500/10 text-red-600 dark:text-red-400 flex items-center justify-center group-hover:scale-110 transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                  </div>
                  <div>
                    <span class="text-xs text-slate-500 dark:text-slate-400 block font-medium">Corporate Hotline (Call & WhatsApp)</span>
                    <span class="text-sm sm:text-base font-bold text-slate-900 dark:text-white font-mono">+8801914457183</span>
                  </div>
                </div>
                <span class="text-xs text-red-600 dark:text-red-400 font-bold group-hover:translate-x-1 transition">Call Now →</span>
              </a>

              <a 
                href="https://wa.me/8801914457183?text=Hello%20Detect%20Fire%20BD,%20we%20need%20a%20corporate%20fire%20safety%20engineering%20quotation." 
                target="_blank"
                class="flex items-center justify-between p-4 rounded-2xl bg-emerald-50 hover:bg-emerald-100/80 dark:bg-emerald-950/40 dark:hover:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800/60 transition group"
              >
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center group-hover:scale-110 transition">
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.073.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564c.173.087.289.13.332.203.043.072.043.419-.101.824z"/>
                    </svg>
                  </div>
                  <div>
                    <span class="text-xs text-emerald-700 dark:text-emerald-400 block font-medium">WhatsApp Priority Chat</span>
                    <span class="text-sm sm:text-base font-bold text-slate-900 dark:text-white font-mono">+8801914457183</span>
                  </div>
                </div>
                <span class="text-xs text-emerald-700 dark:text-emerald-400 font-bold group-hover:translate-x-1 transition">Chat Now →</span>
              </a>

              <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800 text-xs text-slate-500 dark:text-slate-400 space-y-2">
                <div class="flex items-center gap-2 text-slate-700 dark:text-slate-300 font-semibold">
                  <span class="text-emerald-600 dark:text-emerald-400">✓</span>
                  <span>Compliance: BNBC 2020, NFPA & BD Civil Defense</span>
                </div>
                <div class="flex items-center gap-2 text-slate-700 dark:text-slate-300 font-semibold">
                  <span class="text-emerald-600 dark:text-emerald-400">✓</span>
                  <span>Facebook: facebook.com/detectfirebd</span>
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ================= 2. ABOUT US SECTION ================= -->
  <section id="about" class="py-20 sm:py-28 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left: Image & Certifications Badge -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border-2 border-slate-200 dark:border-slate-800 shadow-2xl bg-slate-950">
            <img 
              src="/images/products/alarm-panel.jpg" 
              alt="Detect Fire Engineering BD Operations" 
              class="w-full h-96 object-cover opacity-90 hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent"></div>
            
            <div class="absolute bottom-6 left-6 right-6 p-4 rounded-2xl bg-slate-900/90 border border-slate-700/80 backdrop-blur-md">
              <span class="text-xs font-bold text-red-500 uppercase tracking-wider block mb-1">Our Credential</span>
              <h4 class="text-sm font-bold text-white">Certified by Bangladesh Fire Service & Civil Defense Standards</h4>
            </div>
          </div>
        </div>

        <!-- Right: Story & Capabilities -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-100 dark:bg-red-950/80 text-red-700 dark:text-red-400 text-xs font-bold uppercase tracking-wider">
            <span>🛡️ About Detect Fire Engineering BD</span>
          </div>

          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
            Protecting Bangladesh's Industrial & Commercial Growth
          </h2>

          <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
            <b>Detect Fire Engineering BD</b> is a premier, specialized life-safety engineering enterprise based in Dhaka, Bangladesh. We provide institutional-grade fire protection design, hydraulic pipe routing, addressable detection systems, and turn-key compliance solutions tailored for export-oriented RMG facilities, pharmaceutical plants, commercial towers, and multi-tenant warehouses.
          </p>

          <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
            Our engineering team bridges international standards—such as <b>NFPA (National Fire Protection Association)</b>—with the regulatory guidelines enforced by the <b>Bangladesh Fire Service and Civil Defense Directorate</b> and the <b>BNBC (Bangladesh National Building Code 2020)</b>.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80">
              <div class="text-red-600 font-bold text-lg mb-1">✓ Engineering Precision</div>
              <p class="text-xs text-slate-600 dark:text-slate-400">Computerized hydraulic calculations, 3D piping layouts, and precision pump sizing for zero-pressure loss.</p>
            </div>
            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80">
              <div class="text-red-600 font-bold text-lg mb-1">✓ 100% Audit Readiness</div>
              <p class="text-xs text-slate-600 dark:text-slate-400">Guaranteed clearance for buyer audits (RSC, Accord, Alliance) and local Civil Defense fire licensing.</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ================= 3. SERVICES SECTION ================= -->
  <section id="services" class="py-20 sm:py-28 bg-slate-50 dark:bg-slate-950 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-100 dark:bg-red-950/80 text-red-700 dark:text-red-400 text-xs font-bold uppercase tracking-wider mb-3">
          <span>🛠️ Turnkey Engineering Services</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
          Comprehensive Corporate & Industrial Solutions
        </h2>
        <p class="mt-3 text-slate-600 dark:text-slate-400 text-sm sm:text-base leading-relaxed">
          From initial blueprint design to supply, installation, testing, and annual maintenance contracts.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {corporateServices.map((service) => (
          <div class="bg-white dark:bg-slate-900 rounded-3xl p-8 border border-slate-200 dark:border-slate-800 shadow-xs hover:shadow-xl dark:shadow-slate-950 transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1.5">
            <div>
              <div class="w-14 h-14 rounded-2xl bg-red-50 dark:bg-red-950/50 text-red-600 dark:text-red-400 flex items-center justify-center text-3xl mb-6 group-hover:scale-110 transition">
                {service.icon}
              </div>
              <span class="text-xs font-bold text-red-600 dark:text-red-400 tracking-wider uppercase block mb-1">
                {service.subtitle}
              </span>
              <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors mb-3 leading-snug">
                {service.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-6">
                {service.desc}
              </p>
              
              <div class="space-y-2 pt-4 border-t border-slate-100 dark:border-slate-800 mb-6">
                {service.points.map((point) => (
                  <div class="flex items-center gap-2 text-xs text-slate-700 dark:text-slate-300 font-medium">
                    <span class="text-emerald-500 font-bold">✓</span>
                    <span>{point}</span>
                  </div>
                ))}
              </div>
            </div>

            <a 
              href="#contact" 
              class="w-full inline-flex items-center justify-center gap-2 bg-slate-100 dark:bg-slate-800 hover:bg-red-600 dark:hover:bg-red-600 text-slate-800 dark:text-slate-200 hover:text-white dark:hover:text-white font-bold py-3 rounded-xl text-xs sm:text-sm transition-all"
            >
              <span>Request Service Quotation</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
