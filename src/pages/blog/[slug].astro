---
import Layout from '../../layouts/Layout.astro';
import AnnouncementBar from '../../components/AnnouncementBar.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import FloatingActions from '../../components/FloatingActions.astro';
import { defaultBlogPosts, type BlogPost } from '../../data/blogs';

export async function getStaticPaths() {
  return defaultBlogPosts.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const otherPosts = defaultBlogPosts.filter(p => p.slug !== post.slug).slice(0, 2);
---

<Layout 
  title={`${post.title} | Detect Fire BD`}
  description={post.metaDescription}
>
  <AnnouncementBar />
  <Navbar />

  <!-- Article Header -->
  <header class="bg-gradient-to-b from-slate-50 via-white to-slate-100 dark:bg-gradient-to-br dark:from-slate-950 dark:via-slate-900 dark:to-slate-950 text-slate-900 dark:text-white py-14 sm:py-20 border-b border-slate-200 dark:border-slate-800 transition-colors">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6">
        <a href="/" class="hover:text-slate-900 dark:hover:text-white transition">হোম</a>
        <span>/</span>
        <a href="/blog" class="hover:text-slate-900 dark:hover:text-white transition">ব্লগ</a>
        <span>/</span>
        <span class="text-slate-700 dark:text-slate-300 truncate max-w-xs">{post.category}</span>
      </nav>

      <!-- Category Tag & Meta -->
      <div class="flex items-center gap-3 mb-4">
        <span class="bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full shadow-xs">
          {post.category}
        </span>
        <span class="text-xs text-slate-500 dark:text-slate-400">প্রকাশিত: {post.publishedAt}</span>
        <span class="text-xs text-slate-400">•</span>
        <span class="text-xs text-slate-500 dark:text-slate-400">পড়তে সময়: {post.readTime}</span>
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white leading-tight tracking-tight mb-6">
        {post.title}
      </h1>

      <!-- Author Bio bar -->
      <div class="flex items-center gap-3 pt-6 border-t border-slate-200 dark:border-slate-800">
        <div class="w-10 h-10 rounded-full bg-red-600 text-white flex items-center justify-center font-bold text-sm shadow-md">
          DF
        </div>
        <div>
          <div class="text-sm font-bold text-slate-900 dark:text-white">{post.author}</div>
          <div class="text-xs text-slate-500 dark:text-slate-400">অগ্নি নিরাপত্তা বিশেষজ্ঞ ও কনসালটেন্ট</div>
        </div>
      </div>

    </div>
  </header>

  <!-- Article Content & Sidebar -->
  <main class="py-12 sm:py-16 bg-white dark:bg-slate-900 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Main Article Body -->
        <article class="lg:col-span-8 space-y-8">
          
          <!-- Featured Image -->
          <div class="rounded-3xl overflow-hidden border border-slate-200 dark:border-slate-800 shadow-md max-h-[420px] bg-slate-100 dark:bg-slate-950">
            <img 
              src={post.featuredImage} 
              alt={post.title} 
              class="w-full h-full object-cover"
            />
          </div>

          <!-- HTML Content Body -->
          <div 
            class="prose prose-slate dark:prose-invert max-w-none prose-headings:font-bold prose-headings:text-slate-900 dark:prose-headings:text-white prose-h2:text-2xl prose-h2:mt-8 prose-h2:mb-4 prose-h3:text-xl prose-h3:mt-6 prose-p:text-slate-700 dark:prose-p:text-slate-300 prose-p:leading-relaxed prose-p:text-base prose-li:text-slate-700 dark:prose-li:text-slate-300 prose-strong:text-slate-900 dark:prose-strong:text-white leading-relaxed space-y-4"
            set:html={post.content}
          />

          <!-- Share on Social Media -->
          <div class="pt-8 border-t border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-4">
            <div class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">
              আর্টিকেলটি শেয়ার করুন:
            </div>
            <div class="flex items-center gap-2">
              <a 
                href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent('https://detectfirebd.com/blog/' + post.slug)}`}
                target="_blank"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#1877F2] text-white text-xs font-bold hover:opacity-90 transition"
              >
                <span>Facebook</span>
              </a>
              <a 
                href={`https://api.whatsapp.com/send?text=${encodeURIComponent(post.title + ' ' + 'https://detectfirebd.com/blog/' + post.slug)}`}
                target="_blank"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#25D366] text-white text-xs font-bold hover:opacity-90 transition"
              >
                <span>WhatsApp</span>
              </a>
            </div>
          </div>

          <!-- B2B Consultation Card inside blog -->
          <div class="bg-gradient-to-br from-slate-900 to-slate-950 text-white rounded-3xl p-6 sm:p-8 border border-slate-800 shadow-xl mt-8">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
              <div>
                <span class="text-xs font-bold text-red-400 uppercase tracking-wider">ইন্ডাস্ট্রিয়াল সাপোর্ট</span>
                <h3 class="text-xl font-bold text-white mt-1">আপনার কারখানার জন্য ফায়ার অডিট বা সিলিন্ডার রিফিল দরকার?</h3>
                <p class="text-xs text-slate-400 mt-1 max-w-md">Detect Fire Engineering BD ফ্যাক্টরি ভিজিট করে সিভিল ডিফেন্সের স্ট্যান্ডার্ড অনুযায়ী সেবা প্রদান করে।</p>
              </div>
              <a 
                href="/#rfq" 
                class="shrink-0 bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-700 hover:to-rose-700 text-white font-bold text-xs sm:text-sm px-6 py-3 rounded-xl shadow-lg transition"
              >
                কোটেশন চান
              </a>
            </div>
          </div>

        </article>

        <!-- Right Sticky Sidebar -->
        <aside class="lg:col-span-4 space-y-6">
          
          <!-- Retail Shop CTA Widget -->
          <div class="bg-slate-50 dark:bg-slate-950/60 border border-slate-200/90 dark:border-slate-800 rounded-3xl p-6 shadow-xs">
            <span class="text-xs font-bold text-red-600 dark:text-red-400 uppercase tracking-wider block mb-1">রিটেইল শপ</span>
            <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">বাসা ও অফিসের জন্য ফায়ার এক্সটিংগুইশার</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mb-4 leading-relaxed">
              ৩ কেজি ও ৫ কেজি এবিসি সিলিন্ডার এবং ওয়্যারলেস স্মোক ডিটেক্টর সরাসরি ক্যাশ অন ডেলিভারিতে অর্ডার করুন।
            </p>
            <div class="space-y-3 mb-5">
              <div class="flex items-center gap-3 p-2 bg-white dark:bg-slate-900 rounded-xl border border-slate-200/60 dark:border-slate-800">
                <img src="/images/products/extinguisher-abc.jpg" alt="3kg ABC" class="w-12 h-12 object-contain" />
                <div class="text-xs">
                  <div class="font-bold text-slate-900 dark:text-white">৩ কেজি ABC সিলিন্ডার</div>
                  <div class="text-red-600 dark:text-red-400 font-black">৳১,৪৫০</div>
                </div>
              </div>
              <div class="flex items-center gap-3 p-2 bg-white dark:bg-slate-900 rounded-xl border border-slate-200/60 dark:border-slate-800">
                <img src="/images/products/smoke-detector.jpg" alt="Smoke Detector" class="w-12 h-12 object-contain" />
                <div class="text-xs">
                  <div class="font-bold text-slate-900 dark:text-white">স্মার্ট স্মোক ডিটেক্টর</div>
                  <div class="text-red-600 dark:text-red-400 font-black">৳৮৫০</div>
                </div>
              </div>
            </div>
            <a 
              href="/store" 
              class="w-full inline-flex items-center justify-center gap-2 bg-red-600 hover:bg-red-700 text-white font-bold py-2.5 rounded-xl text-xs transition shadow-md"
            >
              <span>অনলাইন স্টোরে অর্ডার করুন</span>
              <span>→</span>
            </a>
          </div>

          <!-- Hotlines Card -->
          <div class="bg-white dark:bg-slate-950/60 border border-slate-200/90 dark:border-slate-800 rounded-3xl p-6 shadow-xs space-y-3">
            <h4 class="text-sm font-bold text-slate-900 dark:text-white">জরুরি যোগাযোগ ও পরামর্শ</h4>
            <a 
              href="tel:+8801914457183" 
              class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 dark:bg-slate-900 hover:bg-red-50 dark:hover:bg-red-950/30 text-slate-800 dark:text-slate-200 hover:text-red-600 dark:hover:text-red-400 border border-slate-200/80 dark:border-slate-800 transition"
            >
              <span class="text-red-600 font-bold">📞</span>
              <div class="text-xs">
                <span class="block text-red-600 dark:text-red-400 font-bold">হটলাইন ও WhatsApp:</span>
                <span class="font-bold font-mono">+8801914457183</span>
              </div>
            </a>
            <a 
              href="tel:+8801320580631" 
              class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 dark:bg-slate-900 hover:bg-red-50 dark:hover:bg-red-950/30 text-slate-800 dark:text-slate-200 hover:text-red-600 dark:hover:text-red-400 border border-slate-200/80 dark:border-slate-800 transition"
            >
              <span class="text-red-600 font-bold">📞</span>
              <div class="text-xs">
                <span class="block text-slate-500 dark:text-slate-400">কর্পোরেট ডেস্ক:</span>
                <span class="font-bold font-mono">+8801320580631</span>
              </div>
            </a>
          </div>

          <!-- Other Articles -->
          <div class="bg-white dark:bg-slate-950/60 border border-slate-200/90 dark:border-slate-800 rounded-3xl p-6 shadow-xs">
            <h4 class="text-sm font-bold text-slate-900 dark:text-white mb-4 pb-2 border-b border-slate-100 dark:border-slate-800">আরও পড়ুন</h4>
            <div class="space-y-4">
              {otherPosts.map((op) => (
                <a href={`/blog/${op.slug}`} class="group block">
                  <span class="text-[10px] font-bold text-red-600 dark:text-red-400 uppercase">{op.category}</span>
                  <h5 class="text-xs font-bold text-slate-800 dark:text-slate-200 group-hover:text-red-600 dark:group-hover:text-red-400 transition leading-snug mt-0.5 line-clamp-2">
                    {op.title}
                  </h5>
                  <span class="text-[10px] text-slate-400 dark:text-slate-500 mt-1 block">{op.readTime}</span>
                </a>
              ))}
            </div>
          </div>

        </aside>

      </div>
    </div>
  </main>

  <Footer />
  <FloatingActions />
</Layout>
