---
import Layout from '../../layouts/Layout.astro';
import AnnouncementBar from '../../components/AnnouncementBar.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import FloatingActions from '../../components/FloatingActions.astro';
import { defaultBlogPosts } from '../../data/blogs';

const categories = ['সকল', 'পণ্য গাইড', 'কমপ্লায়েন্স ও লাইসেন্স', 'অগ্নি সচেতনতা'];
---

<Layout 
  title="ফায়ার সেফটি ও কমপ্লায়েন্স ব্লগ | Detect Fire BD"
  description="বাংলাদেশে অগ্নিনিরাপত্তা, ফায়ার লাইসেন্স কমপ্লায়েন্স, ৩ কেজি ও ৫ কেজি এক্সটিংগুইশার ব্যবহারের সঠিক নিয়ম এবং ফ্যাক্টরি সেফটি গাইডলাইন।"
>
  <AnnouncementBar />
  <Navbar />

  <!-- Blog Hero -->
  <section class="bg-gradient-to-b from-slate-50 via-white to-slate-100 dark:bg-gradient-to-br dark:from-slate-950 dark:via-slate-900 dark:to-slate-950 text-slate-900 dark:text-white py-16 sm:py-24 border-b border-slate-200 dark:border-slate-800 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-100 dark:bg-red-950/80 border border-red-200 dark:border-red-500/30 text-red-600 dark:text-red-400 text-xs font-bold uppercase tracking-wider mb-4">
        <span>📖 নলেজ হাব ও সেফটি রিসোর্স</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
        ফায়ার সেফটি, ইঞ্জিনিয়ারিং ও কমপ্লায়েন্স ব্লগ
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
        অগ্নিকাণ্ড প্রতিরোধ, আধুনিক ডিটেকশন প্রযুক্তি এবং বাংলাদেশ সিভিল ডিফেন্সের নিয়মাবলী সম্পর্কিত প্রয়োজনীয় আর্টিকেল ও গাইড।
      </p>

      <!-- Category Badges -->
      <div class="flex flex-wrap items-center justify-center gap-2 mt-8" id="blog-category-filter">
        {categories.map((cat, idx) => (
          <button 
            type="button" 
            data-cat={cat}
            class={`px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition cursor-pointer blog-filter-btn ${idx === 0 ? 'bg-red-600 text-white shadow-md' : 'bg-slate-200/80 hover:bg-slate-300 dark:bg-slate-800/80 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300'}`}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Blog Listing Grid -->
  <section class="py-16 sm:py-24 bg-slate-50 dark:bg-slate-950 min-h-[60vh] transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Grid Container -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="blog-posts-grid">
        {defaultBlogPosts.map((post) => (
          <article 
            data-category={post.category}
            class="blog-card bg-white dark:bg-slate-900 rounded-3xl overflow-hidden border border-slate-200/90 dark:border-slate-800 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1.5"
          >
            <div>
              <div class="relative h-56 bg-slate-100 dark:bg-slate-800 overflow-hidden">
                <img 
                  src={post.featuredImage} 
                  alt={post.title} 
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <span class="absolute top-4 left-4 bg-red-600 text-white text-[11px] font-bold px-3 py-1 rounded-full shadow-xs">
                  {post.category}
                </span>
              </div>

              <div class="p-6 sm:p-7">
                <div class="flex items-center gap-2 text-xs text-slate-400 dark:text-slate-500 mb-3">
                  <span>{post.publishedAt}</span>
                  <span>•</span>
                  <span>{post.readTime}</span>
                </div>

                <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors leading-snug">
                  <a href={`/blog/${post.slug}`}>{post.title}</a>
                </h2>

                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-3 line-clamp-3 leading-relaxed">
                  {post.metaDescription}
                </p>
              </div>
            </div>

            <div class="p-6 sm:p-7 pt-0 flex items-center justify-between border-t border-slate-100 dark:border-slate-800/80 mt-2">
              <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">লেখক: {post.author.split(' ')[0]}</span>
              <a 
                href={`/blog/${post.slug}`} 
                class="inline-flex items-center gap-1 text-xs sm:text-sm font-bold text-red-600 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300 group-hover:translate-x-0.5 transition-transform"
              >
                <span>সম্পূর্ণ পড়ুন</span>
                <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Live Dynamic Firestore Sync Notice -->
      <div id="dynamic-blogs-notice" class="hidden mt-8 text-center text-xs text-slate-500 dark:text-slate-400">
        ডাটাবেস থেকে অতিরিক্ত নতুন আর্টিকেল যুক্ত হয়েছে
      </div>

    </div>
  </section>

  <!-- CTA Banner -->
  <section class="bg-gradient-to-r from-red-600 to-rose-600 py-12 px-4 text-white text-center">
    <div class="max-w-4xl mx-auto space-y-4">
      <h3 class="text-2xl sm:text-3xl font-black">আপনার ফ্যাক্টরি বা ভবনের জন্য ফায়ার সেফটি অডিট প্রয়োজন?</h3>
      <p class="text-sm text-red-100 max-w-xl mx-auto">আমাদের ফায়ার সেফটি ইঞ্জিনিয়ারের সাথে সরাসরি কথা বলুন এবং বিনামূল্যে প্রাথমিক পরামর্শ নিন।</p>
      <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
        <a 
          href="/#rfq" 
          class="bg-white text-red-600 hover:bg-red-50 font-bold px-6 py-3 rounded-xl shadow-lg transition"
        >
          কর্পোরেট কোটেশন চান
        </a>
        <a 
          href="https://wa.me/8801914457183" 
          target="_blank"
          class="bg-red-950/60 hover:bg-red-950 text-white font-bold px-6 py-3 rounded-xl border border-red-400/40 transition"
        >
          হোয়াটসঅ্যাপে যোগাযোগ
        </a>
      </div>
    </div>
  </section>

  <Footer />
  <FloatingActions />
</Layout>

<script>
  import { db } from '../../lib/firebase';
  import { collection, getDocs } from 'firebase/firestore';

  // Category Filter
  const filterButtons = document.querySelectorAll('.blog-filter-btn');
  const blogCards = document.querySelectorAll('.blog-card');

  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      filterButtons.forEach(b => {
        b.classList.remove('bg-red-600', 'text-white', 'shadow-md');
        b.classList.add('bg-slate-200/80', 'text-slate-700', 'dark:bg-slate-800/80', 'dark:text-slate-300');
      });
      btn.classList.add('bg-red-600', 'text-white', 'shadow-md');
      btn.classList.remove('bg-slate-200/80', 'text-slate-700', 'dark:bg-slate-800/80', 'dark:text-slate-300');

      const target = btn.getAttribute('data-cat');
      blogCards.forEach(card => {
        const cat = card.getAttribute('data-category');
        if (target === 'সকল' || cat === target) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // Client-side Firestore sync for newly posted blogs from admin
  async function syncFirestoreBlogs() {
    try {
      const snap = await getDocs(collection(db, 'blog_posts'));
      if (snap.empty) return;

      const grid = document.getElementById('blog-posts-grid');
      const existingSlugs = new Set(
        Array.from(document.querySelectorAll('.blog-card a')).map(a => (a as HTMLAnchorElement).pathname)
      );

      snap.forEach(doc => {
        const data = doc.data();
        const path = `/blog/${data.slug}`;
        if (!existingSlugs.has(path) && grid) {
          const article = document.createElement('article');
          article.setAttribute('data-category', data.category || 'সাধারণ');
          article.className = 'blog-card bg-white dark:bg-slate-900 rounded-3xl overflow-hidden border border-slate-200/90 dark:border-slate-800 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1.5';
          article.innerHTML = `
            <div>
              <div class="relative h-56 bg-slate-100 dark:bg-slate-800 overflow-hidden">
                <img 
                  src="${data.featuredImage || '/images/products/extinguisher-abc.jpg'}" 
                  alt="${data.title}" 
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <span class="absolute top-4 left-4 bg-red-600 text-white text-[11px] font-bold px-3 py-1 rounded-full shadow-xs">
                  ${data.category || 'সেফটি'}
                </span>
              </div>

              <div class="p-6 sm:p-7">
                <div class="flex items-center gap-2 text-xs text-slate-400 dark:text-slate-500 mb-3">
                  <span>${data.publishedAt || 'আজ'}</span>
                  <span>•</span>
                  <span>${data.readTime || '৫ মিনিট'}</span>
                </div>

                <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors leading-snug">
                  <a href="/blog/${data.slug}">${data.title}</a>
                </h2>

                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-3 line-clamp-3 leading-relaxed">
                  ${data.metaDescription || ''}
                </p>
              </div>
            </div>

            <div class="p-6 sm:p-7 pt-0 flex items-center justify-between border-t border-slate-100 dark:border-slate-800/80 mt-2">
              <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">লেখক: ${(data.author || 'Detect Fire').split(' ')[0]}</span>
              <a 
                href="/blog/${data.slug}" 
                class="inline-flex items-center gap-1 text-xs sm:text-sm font-bold text-red-600 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300 group-hover:translate-x-0.5 transition-transform"
              >
                <span>সম্পূর্ণ পড়ুন</span>
                <span>→</span>
              </a>
            </div>
          `;
          grid.prepend(article);
        }
      });
    } catch (err) {
      console.warn('Live blogs sync:', err);
    }
  }

  syncFirestoreBlogs();
</script>