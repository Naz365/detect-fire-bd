---
import Layout from '../layouts/Layout.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="পেজটি পাওয়া যায়নি (404) | Detect Fire BD"
  description="অনুরোধকৃত পেজটি খুঁজে পাওয়া যায়নি।"
>
  <AnnouncementBar />
  <Navbar />

  <!-- Dynamic Blog Loader or 404 Display -->
  <div id="dynamic-blog-view" class="hidden min-h-[70vh] py-14 bg-white dark:bg-slate-900 transition-colors">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div id="dynamic-blog-loading" class="text-center py-20 text-slate-500 dark:text-slate-400">
        <div class="w-10 h-10 border-4 border-red-500 border-t-transparent rounded-full animate-spin mx-auto mb-3"></div>
        <p class="text-sm font-semibold">আর্টিকেলটি লোড হচ্ছে...</p>
      </div>

      <article id="dynamic-blog-content" class="hidden space-y-6">
        <div class="flex items-center gap-2">
          <span id="dyn-cat" class="bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full"></span>
          <span id="dyn-meta" class="text-xs text-slate-400 dark:text-slate-500"></span>
        </div>
        <h1 id="dyn-title" class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white leading-tight"></h1>
        <div class="w-full h-80 rounded-2xl overflow-hidden bg-slate-900 border border-slate-200 dark:border-slate-800">
          <img id="dyn-img" src="" alt="" class="w-full h-full object-cover" />
        </div>
        <div id="dyn-body" class="prose prose-slate dark:prose-invert max-w-none text-slate-700 dark:text-slate-300 leading-relaxed space-y-4 pt-4"></div>
      </article>
    </div>
  </div>

  <!-- Regular 404 Fallback -->
  <div id="regular-404" class="min-h-[60vh] flex items-center justify-center py-16 px-4 bg-slate-50 dark:bg-slate-950 text-center transition-colors">
    <div class="max-w-md w-full bg-white dark:bg-slate-900 p-8 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-xl space-y-4">
      <div class="w-16 h-16 bg-red-100 dark:bg-red-950/60 text-red-600 dark:text-red-400 rounded-full flex items-center justify-center text-3xl mx-auto font-bold">
        ⚠️
      </div>
      <h1 class="text-2xl font-black text-slate-900 dark:text-white">পেজটি খুঁজে পাওয়া যায়নি</h1>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed">
        আপনি যে লিংকটি খুঁজছেন তা হয়তো মুছে ফেলা হয়েছে বা ভুল টাইপ করা হয়েছে।
      </p>
      <div class="pt-2 flex flex-col sm:flex-row gap-2 justify-center">
        <a href="/" class="bg-red-600 hover:bg-red-700 text-white font-bold px-5 py-2.5 rounded-xl text-xs transition">
          হোমপেজে যান
        </a>
        <a href="/store" class="bg-slate-800 hover:bg-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 text-white font-bold px-5 py-2.5 rounded-xl text-xs transition">
          অনলাইন শপে যান
        </a>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  import { db } from '../lib/firebase';
  import { doc, getDoc } from 'firebase/firestore';

  const pathname = window.location.pathname;
  if (pathname.startsWith('/blog/')) {
    const slug = pathname.replace(/^\/blog\//, '').replace(/\/$/, '');
    if (slug) {
      const dynamicBlogView = document.getElementById('dynamic-blog-view');
      const regular404 = document.getElementById('regular-404');
      const dynamicBlogLoading = document.getElementById('dynamic-blog-loading');
      const dynamicBlogContent = document.getElementById('dynamic-blog-content');

      regular404?.classList.add('hidden');
      dynamicBlogView?.classList.remove('hidden');

      getDoc(doc(db, 'blog_posts', slug)).then(snap => {
        if (snap.exists()) {
          const data = snap.data();
          (document.getElementById('dyn-cat') as HTMLElement).innerText = data.category || 'সেফটি গাইড';
          (document.getElementById('dyn-meta') as HTMLElement).innerText = `${data.publishedAt || 'আজ'} • ${data.readTime || '৫ মিনিট'}`;
          (document.getElementById('dyn-title') as HTMLElement).innerText = data.title;
          (document.getElementById('dyn-img') as HTMLImageElement).src = data.featuredImage || '/images/products/extinguisher-abc.jpg';
          (document.getElementById('dyn-body') as HTMLElement).innerHTML = data.content;

          dynamicBlogLoading?.classList.add('hidden');
          dynamicBlogContent?.classList.remove('hidden');
          document.title = `${data.title} | Detect Fire BD`;
        } else {
          dynamicBlogView?.classList.add('hidden');
          regular404?.classList.remove('hidden');
        }
      }).catch(() => {
        dynamicBlogView?.classList.add('hidden');
        regular404?.classList.remove('hidden');
      });
    }
  }
</script>