              <textarea 
                id="b-content" 
                rows="10" 
                placeholder="এখানে আপনার সম্পূর্ণ ব্লগ লিখুন। প্যারাগ্রাফ, <h2>সাব-হেডিং</h2>, ও <ul><li>পয়েন্ট</li></ul> ব্যবহার করতে পারেন।" 
                required
                class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-hidden focus:border-emerald-500 transition font-mono"
              ></textarea>
            </div>

            <!-- Submit Button & Feedback -->
