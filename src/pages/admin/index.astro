---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="অ্যাডমিন প্যানেল | Detect Fire BD"
  description="পণ্য আপলোড, মূল্য নির্ধারণ ও এসইও ব্লগ ম্যানেজমেন্ট ড্যাশবোর্ড।"
>
  <div class="min-h-screen bg-slate-900 text-slate-100 flex flex-col font-sans">
    
    <!-- Top Header -->
    <header class="bg-slate-850 border-b border-slate-800 px-4 sm:px-8 py-4 flex items-center justify-between sticky top-0 z-30 shadow-md">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-white p-1 flex items-center justify-center overflow-hidden border border-red-500">
          <img src="/images/logo.png" alt="Detect Fire" class="w-full h-full object-contain" />
        </div>
        <div>
          <h1 class="text-lg font-bold text-white flex items-center gap-2">
            Detect Fire <span class="text-xs bg-red-600 text-white px-2 py-0.5 rounded-full uppercase tracking-wider">Admin</span>
          </h1>
          <p class="text-xs text-slate-400">কন্ট্রোল ড্যাশবোর্ড (পণ্য ও এসইও ব্লগ)</p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <a 
          href="/" 
          target="_blank"
          class="text-xs text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 px-3 py-1.5 rounded-lg border border-slate-700 transition flex items-center gap-1.5"
        >
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          <span class="hidden sm:inline">B2B ওয়েবসাইট</span>
        </a>
        <a 
          href="/store" 
          target="_blank"
          class="text-xs text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 px-3 py-1.5 rounded-lg border border-slate-700 transition flex items-center gap-1.5"
        >
          <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span class="hidden sm:inline">রিটেইল শপ</span>
        </a>
        <button 
          id="logout-btn" 
          class="text-xs text-rose-400 hover:text-rose-300 bg-rose-950/40 hover:bg-rose-900/60 px-3 py-1.5 rounded-lg border border-rose-800/50 transition hidden"
        >
          লগআউট
        </button>
      </div>
    </header>

    <!-- Login Modal (PIN Protection) -->
    <div id="auth-overlay" class="fixed inset-0 z-50 bg-slate-950/90 backdrop-blur-md flex items-center justify-center p-4">
      <div class="bg-slate-850 border border-slate-700 rounded-2xl max-w-sm w-full p-6 shadow-2xl text-center">
        <div class="w-16 h-16 bg-red-600/10 border border-red-500/30 rounded-full flex items-center justify-center mx-auto mb-4 text-red-500">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <h2 class="text-xl font-bold text-white mb-1">অ্যাডমিন প্রবেশদ্বার</h2>
        <p class="text-xs text-slate-400 mb-5">ড্যাশবোর্ড ব্যবহারের জন্য অ্যাডমিন পাসওয়ার্ড বা পিন দিন</p>

        <form id="pin-form" class="space-y-4">
          <div>
            <input 
              type="password" 
              id="admin-pin-input" 
              placeholder="পাসওয়ার্ড লিখুন..." 
              required
              class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-center text-lg tracking-widest text-white focus:outline-hidden focus:border-red-500 focus:ring-1 focus:ring-red-500 transition"
            />
          </div>
          <p id="pin-error" class="text-xs text-rose-500 hidden font-medium">ভুল পাসওয়ার্ড! আবার চেষ্টা করুন।</p>
          <button 
            type="submit" 
            class="w-full bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-700 hover:to-rose-700 text-white font-bold py-3 rounded-xl shadow-lg transition"
          >
            লগইন করুন
          </button>
        </form>
        <p class="text-[11px] text-slate-500 mt-4">ডিফল্ট পাসওয়ার্ড: <span class="text-slate-400 font-mono">detectfire2026</span></p>
      </div>
    </div>

    <!-- Admin Main Body (Hidden until authenticated) -->
    <main id="admin-main" class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 space-y-8 hidden">

      <!-- Navigation Tabs -->
      <div class="flex items-center justify-between border-b border-slate-800 pb-3 flex-wrap gap-4">
        <div class="flex items-center gap-2 bg-slate-800 p-1 rounded-xl">
          <button 
            id="tab-btn-products" 
            class="px-5 py-2.5 rounded-lg text-sm font-bold transition flex items-center gap-2 bg-red-600 text-white shadow-sm"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
            <span>পণ্য ব্যবস্থাপনা (<span id="product-count-badge">০</span>)</span>
          </button>
          <button 
            id="tab-btn-blogs" 
            class="px-5 py-2.5 rounded-lg text-sm font-semibold text-slate-400 hover:text-white transition flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
            <span>এসইও ব্লগ পোস্ট (<span id="blog-count-badge">০</span>)</span>
          </button>
          <button 
            id="tab-btn-orders" 
            class="px-5 py-2.5 rounded-lg text-sm font-semibold text-slate-400 hover:text-white transition flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            <span>অর্ডারসমূহ (<span id="order-count-badge">০</span>)</span>
          </button>
        </div>

        <!-- Sync Database helper buttons -->
        <div class="flex items-center gap-2">
          <button 
            id="btn-sync-defaults" 
            class="text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700 px-3 py-2 rounded-xl transition flex items-center gap-1.5"
            title="প্রাথমিক পণ্যগুলো ফায়ারস্টোর ডাটাবেসে সেভ করুন"
          >
            <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
            </svg>
            <span>ডিফল্ট পণ্য সিঙ্ক করুন</span>
          </button>
          <button 
            id="btn-sync-blogs" 
            class="text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700 px-3 py-2 rounded-xl transition flex items-center gap-1.5"
            title="প্রাথমিক এসইও ব্লগগুলো ডাটাবেসে সেভ করুন"
          >
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>ডিফল্ট ব্লগ সিঙ্ক করুন</span>
          </button>
        </div>
      </div>

      <!-- ================= SECTION 1: PRODUCTS ================= -->
      <div id="section-products" class="space-y-8">
        
        <!-- Add Product Form Card -->
        <div class="bg-slate-850 border border-slate-800 rounded-2xl p-6 shadow-xl">
          <div class="flex items-center justify-between mb-6 pb-3 border-b border-slate-800">
            <div>
              <h2 class="text-lg font-bold text-white flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-red-500"></span>
                নতুন পণ্য আপলোড ফরম
              </h2>
              <p class="text-xs text-slate-400 mt-0.5">ছবি ড্র্যাগ অ্যান্ড ড্রপ করুন এবং পণ্যের বিবরণ দিয়ে সরাসরি পাবলিশ করুন</p>
            </div>
            <span class="text-xs text-slate-500 bg-slate-900 px-2.5 py-1 rounded-md border border-slate-800">
              Cloud Firestore + ImgBB
            </span>
          </div>

          <form id="add-product-form" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              
              <!-- Product Name -->
              <div class="lg:col-span-2">
                <label class="block text-xs font-semibold text-slate-300 mb-2">পণ্যের নাম *</label>
                <input 
                  type="text" 
                  id="p-name" 
                  placeholder="যেমন: ABC Dry Powder ফায়ার এক্সটিংগুইশার" 
                  required
                  class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-hidden focus:border-red-500 transition"
                />
              </div>

              <!-- Category -->
              <div>
                <label class="block text-xs font-semibold text-slate-300 mb-2">ক্যাটাগরি *</label>
                <select 
                  id="p-category" 
                  required
                  class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-hidden focus:border-red-500 transition"
                >
                  <option value="extinguisher">ফায়ার এক্সটিংগুইশার</option>
                  <option value="combo">স্পেশাল কম্বো অফার</option>
                  <option value="gear">সেফটি গিয়ার ও পিপিই</option>
                  <option value="sensor">স্মোক ও গ্যাস ডিটেক্টর</option>
                  <option value="panel">কন্ট্রোল প্যানেল ও এক্সেসরিজ</option>
                </select>
              </div>

              <!-- Weight / Variant Tag -->
              <div>
                <label class="block text-xs font-semibold text-slate-300 mb-2">ভেরিয়েন্ট / সাইজ ট্যাগ</label>
                <input 
                  type="text" 
                  id="p-tag" 
                  placeholder="যেমন: ৩ কেজি অথবা ৫ কেজি" 
                  class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-hidden focus:border-red-500 transition"
                />
                <span class="text-[10px] text-slate-500">বাংলাদেশে স্ট্যান্ডার্ড সাইজ: ৩ কেজি অথবা ৫ কেজি</span>
              </div>

              <!-- Regular Price -->
              <div>
                <label class="block text-xs font-semibold text-slate-300 mb-2">আসল মূল্য (৳) *</label>
                <input 
                  type="number" 
                  id="p-regular-price" 
                  placeholder="যেমন: ১৮৫০" 
                  required
                  class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-hidden focus:border-red-500 transition"
                />
              </div>

              <!-- Sale Price -->
              <div>
                <label class="block text-xs font-semibold text-slate-300 mb-2">অফার মূল্য (৳) *</label>
                <input 
                  type="number" 
                  id="p-sale-price" 
                  placeholder="যেমন: ১৪৫০" 
                  required
                  class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-hidden focus:border-red-500 transition"
                />
              </div>
            </div>

            <!-- Image Upload Zone (ImgBB Integration) -->
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-2">পণ্যের ছবি (ড্র্যাগ অ্যান্ড ড্রপ অথবা সিলেক্ট করুন) *</label>
              
              <div 
                id="drop-zone" 
                class="border-2 border-dashed border-slate-700 hover:border-red-500/80 rounded-2xl p-6 text-center cursor-pointer bg-slate-900/60 hover:bg-slate-900 transition flex flex-col items-center justify-center min-h-[160px] relative group"
              >
                <input 
                  type="file" 
                  id="p-image-file" 
                  accept="image/*" 
                  class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" 
                />

                <div id="upload-prompt" class="flex flex-col items-center pointer-events-none">
                  <div class="w-12 h-12 rounded-full bg-red-600/10 text-red-500 flex items-center justify-center mb-2 group-hover:scale-110 transition">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <p class="text-sm font-semibold text-white">ছবি এখানে এনে ছেড়ে দিন অথবা ক্লিক করুন</p>
                  <p class="text-xs text-slate-500 mt-1">স্বয়ংক্রিয়ভাবে ImgBB ক্লাউড স্টোরেজে আপলোড হবে (JPG, PNG, WEBP)</p>
                </div>

                <!-- Live Upload Preview -->
                <div id="upload-preview" class="hidden flex-col items-center z-20">
                  <div class="relative w-28 h-28 rounded-xl overflow-hidden border-2 border-red-500 shadow-lg bg-black">
                    <img id="preview-img" src="" alt="Preview" class="w-full h-full object-cover" />
                    <button 
                      type="button" 
                      id="remove-img-btn" 
                      class="absolute top-1 right-1 bg-rose-600 text-white rounded-full p-1 hover:bg-rose-700 transition"
                      title="ছবি বাদ দিন"
                    >
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                      </svg>
                    </button>
                  </div>
                  <span id="upload-status" class="text-xs text-emerald-400 font-semibold mt-2">ছবি আপলোড সফল!</span>
                </div>

                <!-- Spinner -->
                <div id="upload-spinner" class="hidden flex-col items-center z-20">
                  <div class="w-8 h-8 border-4 border-red-500 border-t-transparent rounded-full animate-spin mb-2"></div>
                  <span class="text-xs text-red-400 font-medium">ছবি আপলোড হচ্ছে... অনুগ্রহ করে অপেক্ষা করুন</span>
                </div>
              </div>

              <!-- Hidden/Manual URL Fallback -->
              <div class="mt-2 flex items-center gap-2">
                <input 
                  type="text" 
                  id="p-image-url" 
                  placeholder="অথবা সরাসরি ইমেজ লিংক (URL) লিখুন" 
                  class="flex-1 bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-slate-300 focus:outline-hidden focus:border-red-500 transition font-mono"
                />
              </div>
            </div>

            <!-- Short Description -->
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-2">সংক্ষিপ্ত বিবরণ *</label>
              <textarea 
                id="p-desc" 
                rows="2" 
                placeholder="পণ্যের ব্যবহার ও প্রাথমিক সুবিধা সম্পর্কে ১-২ লাইনে লিখুন..." 
                required
                class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-hidden focus:border-red-500 transition"
              ></textarea>
            </div>

            <!-- Specifications (Line separated) -->
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-2">পণ্যের বৈশিষ্ট্যসমূহ (প্রতি লাইনে একটি করে বৈশিষ্ট্য লিখুন)</label>
              <textarea 
                id="p-specs" 
                rows="3" 
                placeholder="যেমন:
Class A, B, C আগুনে ১০০% কার্যকর
মেয়াদকাল: ৩ বছর ভ্যালিড
ওয়াল ব্র্যাকেট সহ সম্পূর্ণ নতুন" 
                class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-hidden focus:border-red-500 transition"
              ></textarea>
            </div>

            <!-- Submit Button & Feedback -->
            <div class="flex items-center justify-between pt-2">
              <div id="product-form-msg" class="text-xs font-semibold hidden"></div>
              <button 
                type="submit" 
                id="submit-product-btn" 
                class="bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-700 hover:to-rose-700 text-white font-bold px-8 py-3 rounded-xl shadow-lg transition flex items-center gap-2"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
                <span>পণ্য পাবলিশ করুন</span>
              </button>
            </div>
          </form>
        </div>

        <!-- Current Products List -->
        <div class="bg-slate-850 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-base font-bold text-white flex items-center gap-2">
              <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
              <span>লাইভ পণ্য তালিকা</span>
            </h3>
            <button 
              id="refresh-products-btn" 
              class="text-xs text-slate-400 hover:text-white flex items-center gap-1 bg-slate-900 px-3 py-1.5 rounded-lg border border-slate-800"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
              <span>রিফ্রেশ</span>
            </button>
          </div>

          <div id="products-loading" class="text-center py-10 text-slate-400">
            <div class="w-8 h-8 border-4 border-red-500 border-t-transparent rounded-full animate-spin mx-auto mb-2"></div>
            পণ্য লোড হচ্ছে...
          </div>

          <!-- Product Grid/Table -->
          <div id="products-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 hidden">
            <!-- Dynamically populated -->
          </div>
        </div>
      </div>

      <!-- ================= SECTION 2: BLOGS ================= -->
