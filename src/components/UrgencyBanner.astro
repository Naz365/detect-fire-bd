<section class="bg-gradient-to-r from-red-600 via-rose-600 to-red-700 text-white py-8 px-4 sm:px-6">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
      
      <div class="flex items-center gap-4 border-b md:border-b-0 md:border-r border-red-500/50 pb-4 md:pb-0 md:pr-4">
        <div class="w-14 h-14 rounded-2xl bg-white/10 flex items-center justify-center text-3xl shrink-0 backdrop-blur-sm">
          ⚠️
        </div>
        <div>
          <h2 class="text-lg font-bold">ছোট আগুনেই বড় বিপদ</h2>
          <p class="text-xs text-red-100 leading-relaxed mt-0.5">
            প্রাথমিক ৩০ সেকেন্ডে একটি ফায়ার এক্সটিংগুইশার থাকলে ৯৫% আগুন শুরুতেই নিভিয়ে ফেলা সম্ভব।
          </p>
        </div>
      </div>

      <div class="flex items-center gap-4 border-b md:border-b-0 md:border-r border-red-500/50 pb-4 md:pb-0 md:pr-4">
