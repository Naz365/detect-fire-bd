---
const faqs = [
  {
    q: "ফায়ার এক্সটিংগুইশারের মেয়াদ কতদিন থাকে এবং পরে রিফিল করা যায়?",
    a: "আমাদের সরবরাহকৃত প্রতিটি নতুন সিলিন্ডারে ৩ বছর পর্যন্ত ব্যবহারের ভ্যালিডিটি থাকে। সিলিন্ডারে থাকা প্রেশার গেজে সুইটি সবুজ চিহ্নে থাকলে বুঝবেন এটি ব্যবহারের জন্য প্রস্তুত। মেয়াদ শেষ হলে বা একবার ব্যবহার করার পর আমাদের মাধ্যমে নামমাত্র খরচে পুনরায় রিফিল করে নিতে পারবেন।"
  },
  {
    q: "স্মোক ডিটেক্টর ইনস্টল করতে কি কোনো তার বা ইলেকট্রিশিয়ানের দরকার হয়?",
    a: "একদমই না! আমাদের অপটিক্যাল স্মোক ডিটেক্টর সম্পূর্ণ ওয়্যারলেস এবং একটি ৯ ভোল্ট ব্যাটারিতে পুরো এক বছর নিরবচ্ছিন্নভাবে চলে। প্যাকেজে দেওয়া স্ক্রু অথবা ডাবল-সাইডেড টেপ দিয়ে সিলিংয়ে মাত্র ২ মিনিটে যে কেউ এটি লাগিয়ে নিতে পারেন।"
  },
  {
    q: "ডেলিভারি পেতে কতদিন সময় লাগবে?",
    a: "ঢাকা সিটির ভেতরে অর্ডার কনফার্মের ২৪ থেকে ৪৮ ঘণ্টার মধ্যে ডেলিভারি সম্পন্ন হয়। ঢাকা সিটির বাইরে জেলা ও থানা শহরে সাধারণত ২ থেকে ৩ কার্যদিবসের মধ্যে কুরিয়ারের মাধ্যমে হোম ডেলিভারি পৌঁছে দেওয়া হয়।"
  },
  {
    q: "আমি কি পণ্য হাতে পেয়ে দেখে টাকা পরিশোধ করতে পারব?",
    a: "হ্যাঁ, সম্পূর্ণ ক্যাশ অন ডেলিভারি সুবিধা রয়েছে। ডেলিভারিম্যান থেকে পার্সেলটি গ্রহণ করে ইনট্যাক্ট ও সঠিক প্রোডাক্ট বুঝে নেওয়ার পরই আপনি মূল্য পরিশোধ করবেন। কোনো অগ্রিম পেমেন্টের ঝুঁকি নেই।"
  },
  {
    q: "ফ্যাক্টরি বা অফিসের জন্য বড় লটে পাইকারি অর্ডার দেওয়ার সুযোগ আছে কি?",
    a: "অবশ্যই! গার্মেন্টস, কারখানা, শিক্ষাপ্রতিষ্ঠান বা কমার্শিয়াল ভবনের ফায়ার লাইসেন্স কমপ্লায়েন্সের জন্য যেকোনো পরিমাণ বড় অর্ডারে আমরা বিশেষ পাইকারি দর ও ফ্রি টেকনিক্যাল কনসালটেশন প্রদান করি। সরাসরি আমাদের হটলাইনে যোগাযোগ করুন।"
  }
];
---
<section id="faq" class="py-16 sm:py-20 bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 transition-colors">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-transparent dark:border-slate-700 text-xs font-bold uppercase tracking-wider mb-3">
        <span>❓ আপনার সাধারণ প্রশ্ন</span>
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        সচরাচর জিজ্ঞাসিত <span class="text-red-600 dark:text-red-500">প্রশ্নোত্তর (FAQ)</span>
      </h2>
      <p class="mt-2 text-slate-600 dark:text-slate-400 text-xs sm:text-sm">
        ফায়ার সেফটি আইটেম ও অর্ডার সম্পর্কিত আপনার যেকোনো দ্বিধা দূর করতে নিচের উত্তরগুলো পড়ুন।
      </p>
    </div>

    <!-- FAQ Accordion List -->
    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <details class="group rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 p-5 open:bg-red-50/20 dark:open:bg-red-950/20 open:border-red-200 dark:open:border-red-800/60 transition-colors">
          <summary class="flex items-center justify-between font-bold text-slate-900 dark:text-white text-sm sm:text-base cursor-pointer list-none select-none">
            <span class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full bg-red-100 dark:bg-red-950/80 text-red-600 dark:text-red-400 flex items-center justify-center text-xs font-black shrink-0">
                ?
              </span>
              <span>{faq.q}</span>
            </span>
            <span class="ml-2 w-6 h-6 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 dark:text-slate-400 group-open:rotate-180 transition-transform shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </span>
          </summary>
          <div class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed pl-9 pr-4 border-t border-slate-200/60 dark:border-slate-800/80 pt-3">
            {faq.a}
          </div>
        </details>
      ))}
    </div>

  </div>
</section>
