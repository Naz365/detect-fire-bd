---
---
<section class="relative overflow-hidden bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 text-white pt-10 pb-16 lg:py-20">
  <!-- Subtle decorative ambient glows -->
  <div class="absolute -top-40 -left-40 w-96 h-96 bg-red-600/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 -right-40 w-96 h-96 bg-amber-500/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
      
      <!-- Left Content Column -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        <!-- Attention Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-500/10 border border-red-500/30 text-red-400 text-xs sm:text-sm font-semibold tracking-wide">
          <span class="inline-block w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
          <span>🔥 বিশ্বস্ত ফায়ার ও ইন্ডাস্ট্রিয়াল সেফটি পার্টনার</span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight sm:leading-snug">
          আপনার বাসা, দোকান ও কারখানার <br class="hidden sm:inline" />
          <span class="bg-gradient-to-r from-red-500 via-rose-400 to-amber-400 bg-clip-text text-transparent">
            অগ্নিনিরাপত্তা নিশ্চিত করুন
          </span> 
          এক ক্লিকে
        </h1>

        <!-- Subheadline -->
        <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal">
          অগ্নি দুর্ঘটনা ঘটে মাত্র কয়েক সেকেন্ডে, তবে সতর্কতা বাঁচায় পুরো জীবন ও সম্পদ। ফায়ার এক্সটিংগুইশার, অটো স্মোক ডিটেক্টর, জরুরি সাইরেন ও প্রিমিয়াম সেফটি গিয়ার—সব পাচ্ছেন ১০০% অরিজিনাল গ্যারান্টিতে।
        </p>

        <!-- CTA Buttons -->
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a 
            href="#checkout-section" 
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-500 hover:to-rose-500 text-white font-bold text-lg px-8 py-4 rounded-xl shadow-lg shadow-red-600/30 hover:shadow-red-600/50 transition-all transform hover:-translate-y-1 active:translate-y-0"
          >
            <svg class="w-6 h-6 text-yellow-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
            <span>এখনই অর্ডার করতে চাই</span>
          </a>

          <a 
            href="#combos" 
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-slate-800/80 hover:bg-slate-800 text-slate-200 hover:text-white font-semibold text-base px-6 py-4 rounded-xl border border-slate-700 hover:border-slate-600 transition"
          >
            <span>কম্বো অফার দেখুন</span>
            <svg class="w-4 h-4 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

        <!-- 4 Key Value Highlights -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-6 border-t border-slate-800/80">
          <div class="flex items-center gap-2.5 p-2 rounded-lg bg-slate-900/40 border border-slate-800 text-left">
            <div class="w-9 h-9 rounded-md bg-red-500/10 text-red-400 flex items-center justify-center font-bold text-lg shrink-0">
              ✓
            </div>
            <div>
              <div class="text-xs font-bold text-white">ক্যাশ অন ডেলিভারি</div>
              <div class="text-[11px] text-slate-400">হাতে পেয়ে পেমেন্ট</div>
            </div>
          </div>

          <div class="flex items-center gap-2.5 p-2 rounded-lg bg-slate-900/40 border border-slate-800 text-left">
            <div class="w-9 h-9 rounded-md bg-amber-500/10 text-amber-400 flex items-center justify-center font-bold text-lg shrink-0">
              ★
            </div>
            <div>
              <div class="text-xs font-bold text-white">১০০% অরিজিনাল</div>
              <div class="text-[11px] text-slate-400">ভ্যালিড মেয়াদ ও প্রেশার</div>
            </div>
          </div>

          <div class="flex items-center gap-2.5 p-2 rounded-lg bg-slate-900/40 border border-slate-800 text-left">
            <div class="w-9 h-9 rounded-md bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold text-lg shrink-0">
              ⚡
            </div>
            <div>
              <div class="text-xs font-bold text-white">দ্রুত ডেলিভারি</div>
              <div class="text-[11px] text-slate-400">সারা বাংলাদেশে</div>
            </div>
          </div>

          <div class="flex items-center gap-2.5 p-2 rounded-lg bg-slate-900/40 border border-slate-800 text-left">
            <div class="w-9 h-9 rounded-md bg-blue-500/10 text-blue-400 flex items-center justify-center font-bold text-lg shrink-0">
              🛡️
            </div>
            <div>
              <div class="text-xs font-bold text-white">১ বছর ওয়ারেন্টি</div>
              <div class="text-[11px] text-slate-400">ফ্রি টেকনিক্যাল সাপোর্ট</div>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Visual Grid Column -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <!-- Main Showcase Card -->
          <div class="relative z-10 rounded-2xl bg-gradient-to-b from-slate-800/90 to-slate-900/90 p-4 sm:p-6 border border-slate-700/80 shadow-2xl backdrop-blur-sm">
            
            <div class="flex items-center justify-between pb-4 border-b border-slate-700/60">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">ইন-স্টক ও ডেলিভারি রেডি</span>
              </div>
              <span class="text-xs font-semibold text-slate-400 bg-slate-800 px-2 py-0.5 rounded">DETECT FIRE BD</span>
            </div>

            <!-- Featured Product Composite Display -->
            <div class="grid grid-cols-2 gap-3 py-4">
              <div class="relative bg-slate-950/60 rounded-xl p-3 border border-slate-800 text-center flex flex-col items-center">
                <span class="absolute top-2 right-2 bg-red-600 text-white text-[10px] font-bold px-1.5 py-0.5 rounded">ABC ২ কেজি</span>
                <img src="/images/products/extinguisher-co2.jpg" alt="ফায়ার এক্সটিংগুইশার" class="h-28 sm:h-32 object-contain my-1" />
                <span class="text-xs font-semibold text-slate-200 mt-1">ফায়ার এক্সটিংগুইশার</span>
                <span class="text-xs font-bold text-red-400">৳১,১৫০</span>
              </div>

              <div class="relative bg-slate-950/60 rounded-xl p-3 border border-slate-800 text-center flex flex-col items-center">
                <span class="absolute top-2 right-2 bg-amber-500 text-black text-[10px] font-bold px-1.5 py-0.5 rounded">স্মার্ট অ্যালার্ম</span>
                <img src="/images/products/smoke-detector.jpg" alt="স্মোক ডিটেক্টর" class="h-28 sm:h-32 object-contain my-1" />
                <span class="text-xs font-semibold text-slate-200 mt-1">অপটিক্যাল স্মোক সেন্সর</span>
                <span class="text-xs font-bold text-amber-400">৳৮৫০</span>
              </div>

              <div class="relative bg-slate-950/60 rounded-xl p-3 border border-slate-800 text-center flex flex-col items-center">
                <span class="absolute top-2 right-2 bg-blue-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded">কমপ্লায়েন্স</span>
                <img src="/images/products/safety-helmet.jpg" alt="সেফটি হেলমেট" class="h-28 sm:h-32 object-contain my-1" />
                <span class="text-xs font-semibold text-slate-200 mt-1">ইন্ডাস্ট্রিয়াল হেলমেট</span>
                <span class="text-xs font-bold text-blue-400">৳৪৮০</span>
              </div>

              <div class="relative bg-slate-950/60 rounded-xl p-3 border border-slate-800 text-center flex flex-col items-center">
                <span class="absolute top-2 right-2 bg-emerald-500 text-black text-[10px] font-bold px-1.5 py-0.5 rounded">স্টিল টো</span>
                <img src="/images/products/safety-shoes.jpg" alt="সেফটি শুজ" class="h-28 sm:h-32 object-contain my-1" />
                <span class="text-xs font-semibold text-slate-200 mt-1">প্রটেক্টিভ সেফটি শুজ</span>
                <span class="text-xs font-bold text-emerald-400">৳২,১৫০</span>
              </div>
            </div>

            <!-- Urgent Callout Box -->
            <div class="mt-2 bg-red-950/50 border border-red-700/40 rounded-xl p-3 flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span class="text-2xl">🔥</span>
                <div>
                  <div class="text-xs font-bold text-red-200">হোম ও কিচেন সেফটি কম্বো</div>
                  <div class="text-[11px] text-slate-400">এক্সটিংগুইশার + স্মোক সেন্সর + ব্ল্যাঙ্কেট</div>
                </div>
              </div>
              <a href="#checkout-section" class="text-xs font-bold bg-red-600 hover:bg-red-500 text-white px-3 py-1.5 rounded-lg transition shrink-0">
                অফার নিন
              </a>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>
