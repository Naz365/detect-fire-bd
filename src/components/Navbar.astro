<!-- Customer Authentication Modal -->
<CustomerAuthModal />

<!-- Client Script for Theme, Language & Fullscreen Menu -->
<script>
  import { auth } from '../lib/firebase';
  import { onAuthStateChanged } from 'firebase/auth';

  // ================= NAVBAR CUSTOMER AUTH STATE =================
  const navbarAuthBtn = document.getElementById('navbar-auth-btn');
  const navbarAuthIcon = document.getElementById('navbar-auth-icon');
  const navbarUserInitial = document.getElementById('navbar-user-initial');

  navbarAuthBtn?.addEventListener('click', () => {
    if ((window as any).openCustomerAuthModal) {
      (window as any).openCustomerAuthModal();
    }
  });

  onAuthStateChanged(auth, (user) => {
    if (user) {
      const initial = (user.displayName || user.email || user.phoneNumber || 'U').charAt(0).toUpperCase();
      navbarAuthIcon?.classList.add('hidden');
      if (navbarUserInitial) {
        navbarUserInitial.textContent = initial;
        navbarUserInitial.classList.remove('hidden');
      }
      navbarAuthBtn?.setAttribute('title', user.displayName || user.email || 'My Account');
    } else {
      navbarAuthIcon?.classList.remove('hidden');
      navbarUserInitial?.classList.add('hidden');
      navbarAuthBtn?.setAttribute('title', 'Customer Login');
    }
  });

  // ================= THEME TOGGLE ENGINE =================
  const themeToggleBtn = document.getElementById('theme-toggle-btn');
  const sunIcon = document.getElementById('theme-sun-icon');
  const moonIcon = document.getElementById('theme-moon-icon');

  function updateThemeUI(isDark: boolean) {
    if (isDark) {
      document.documentElement.classList.add('dark');
      sunIcon?.classList.remove('hidden');
      moonIcon?.classList.add('hidden');
      localStorage.setItem('detect_fire_theme', 'dark');
    } else {
      document.documentElement.classList.remove('dark');
      sunIcon?.classList.add('hidden');
      moonIcon?.classList.remove('hidden');
      localStorage.setItem('detect_fire_theme', 'light');
    }
  }

  // Init Theme
  const isCurrentlyDark = document.documentElement.classList.contains('dark');
  updateThemeUI(isCurrentlyDark);

  themeToggleBtn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark');
    updateThemeUI(!isDark);
  });

  // ================= LANGUAGE SWITCHER ENGINE =================
  const btnLangEn = document.getElementById('btn-lang-en');
  const btnLangBn = document.getElementById('btn-lang-bn');
  const shopLabel = document.querySelector('.nav-shop-label');

  let currentLang = localStorage.getItem('detect_fire_lang') || 'EN';

  function applyLanguage(lang: string) {
    currentLang = lang;
    localStorage.setItem('detect_fire_lang', lang);

    if (lang === 'EN') {
      btnLangEn?.classList.add('bg-white', 'dark:bg-slate-800', 'text-slate-950', 'dark:text-white', 'shadow-xs');
      btnLangEn?.classList.remove('text-slate-500', 'dark:text-slate-400');
      btnLangBn?.classList.remove('bg-white', 'dark:bg-slate-800', 'text-slate-950', 'dark:text-white', 'shadow-xs');
      btnLangBn?.classList.add('text-slate-500', 'dark:text-slate-400');

      if (shopLabel) shopLabel.textContent = 'Shop';
    } else {
      btnLangBn?.classList.add('bg-white', 'dark:bg-slate-800', 'text-slate-950', 'dark:text-white', 'shadow-xs');
      btnLangBn?.classList.remove('text-slate-500', 'dark:text-slate-400');
      btnLangEn?.classList.remove('bg-white', 'dark:bg-slate-800', 'text-slate-950', 'dark:text-white', 'shadow-xs');
      btnLangEn?.classList.add('text-slate-500', 'dark:text-slate-400');

      if (shopLabel) shopLabel.textContent = 'শপ';
    }

    // Update Nav Items
    document.querySelectorAll('.nav-link-item').forEach(el => {
      const text = lang === 'EN' ? el.getAttribute('data-en') : el.getAttribute('data-bn');
      if (text) {
        el.textContent = text;
      }
    });
  }

  btnLangEn?.addEventListener('click', () => applyLanguage('EN'));
  btnLangBn?.addEventListener('click', () => applyLanguage('BN'));
  applyLanguage(currentLang);

  // ================= FULLSCREEN MENU LOGIC =================
  const menuToggleBtn = document.getElementById('menu-toggle-btn');
  const menuCloseBtn = document.getElementById('menu-close-btn');
  const overlay = document.getElementById('fullscreen-menu-overlay');
  const closeTriggers = document.querySelectorAll('.menu-close-trigger');

  function openMenu() {
    overlay?.classList.remove('opacity-0', 'pointer-events-none');
    overlay?.classList.add('opacity-100', 'pointer-events-auto');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    overlay?.classList.remove('opacity-100', 'pointer-events-auto');
    overlay?.classList.add('opacity-0', 'pointer-events-none');
    document.body.style.overflow = '';
  }

  menuToggleBtn?.addEventListener('click', openMenu);
  menuCloseBtn?.addEventListener('click', closeMenu);

  closeTriggers.forEach(el => {
    el.addEventListener('click', closeMenu);
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>
