  class="fixed inset-0 z-50 bg-slate-950/98 backdrop-blur-2xl text-white opacity-0 pointer-events-none transition-all duration-300 flex flex-col justify-between overflow-y-auto"
>
  
  <!-- Overlay Header -->
  <div class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 h-20 sm:h-24 flex items-center justify-between border-b border-slate-800/80 shrink-0">
