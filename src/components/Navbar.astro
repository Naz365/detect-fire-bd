    <a href="/" class="flex items-center gap-3.5">
      <div class="w-12 h-12 rounded-xl overflow-hidden border-2 border-red-500 bg-white p-1 flex items-center justify-center shrink-0">
        <img src="/images/logo.png" alt="Detect Fire" class="w-full h-full object-contain" />
      </div>
      <div class="flex flex-col">
        <span class="text-xl font-black tracking-tight text-white">
          DETECT <span class="text-red-500">FIRE</span>
        </span>
        <span class="text-[10px] font-bold tracking-widest text-slate-400 uppercase">
          Engineering BD
        </span>
      </div>
    </a>

    <!-- Overlay Close Button & Language Toggle -->
    <div class="flex items-center gap-3">
      <button 
        type="button" 
        id="menu-close-btn"
        class="w-10 h-10 rounded-full bg-slate-900 hover:bg-red-600 text-slate-300 hover:text-white flex items-center justify-center transition-all border border-slate-800 hover:border-red-500 cursor-pointer"
        aria-label="Close Menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

