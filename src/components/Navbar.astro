---
import CustomerAuthModal from './CustomerAuthModal.astro';
---
<!-- Sticky Clean Corporate Header with Light & Dark Theme Support -->
<header class="sticky top-0 z-40 bg-white/95 dark:bg-slate-950/95 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 shadow-xs transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 sm:h-24 flex items-center justify-between gap-4">
    
    <!-- Left: Prominent Corporate Brand Logo -->
    <a href="/" class="flex items-center gap-3.5 group shrink-0 py-1">
      <!-- Logo Mark Container (Enlarged & High-Resolution) -->
      <div class="relative w-13 h-13 sm:w-16 sm:h-16 rounded-2xl overflow-hidden border-2 border-red-600 dark:border-red-500 shadow-md p-1 bg-white flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform duration-300">
        <img 
          src="/images/logo.png" 
          alt="Detect Fire Engineering BD Logo" 
          class="w-full h-full object-contain"
        />
      </div>

      <!-- Typography -->
      <div class="flex flex-col">
        <div class="flex items-center gap-1.5 leading-none">
          <span class="text-xl sm:text-2xl font-black tracking-tight text-slate-950 dark:text-white">
            DETECT
          </span>
          <span class="text-xl sm:text-2xl font-black tracking-tight text-red-600 dark:text-red-500">
            FIRE
          </span>
        </div>
        <div class="flex items-center gap-1.5 mt-1">
          <span class="text-[11px] sm:text-xs font-black tracking-widest text-slate-600 dark:text-slate-300 uppercase">
            Engineering BD
          </span>
          <span class="hidden sm:inline-block w-1 h-1 rounded-full bg-red-600"></span>
          <span class="hidden sm:inline-block text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">
            Fire & Life Safety
          </span>
        </div>
      </div>
    </a>

    <!-- Center: Corporate Navigation Links (English by Default) -->
    <nav class="hidden lg:flex items-center gap-7 text-sm font-bold text-slate-700 dark:text-slate-200">
      <a 
        href="/" 
        class="hover:text-red-600 dark:hover:text-red-400 transition-colors nav-link-item" 
        data-en="Home" 
        data-bn="হোম"
      >
        Home
      </a>
      <a 
        href="/#about" 
        class="hover:text-red-600 dark:hover:text-red-400 transition-colors nav-link-item" 
        data-en="About Us" 
        data-bn="আমাদের সম্পর্কে"
      >
        About Us
      </a>
      <a 
        href="/#services" 
        class="hover:text-red-600 dark:hover:text-red-400 transition-colors nav-link-item" 
        data-en="Services" 
        data-bn="সার্ভিসসমূহ"
      >
        Services
      </a>
      <a 
        href="/#projects" 
        class="hover:text-red-600 dark:hover:text-red-400 transition-colors nav-link-item" 
        data-en="Our Projects" 
        data-bn="প্রজেক্টসমূহ"
      >
        Our Projects
      </a>
      <a 
        href="/#contact" 
        class="hover:text-red-600 dark:hover:text-red-400 transition-colors nav-link-item" 
        data-en="Contact Us" 
        data-bn="যোগাযোগ"
      >
        Contact Us
      </a>
    </nav>

    <!-- Right Controls: Theme Toggle, Language Switcher, Far-Right SHOP CTA & Hamburger -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      
      <!-- 1. Dark/Light Theme Toggle Button -->
      <button 
        type="button" 
        id="theme-toggle-btn"
        aria-label="Toggle Dark / Light Theme"
        title="Toggle Theme"
        class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-900 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 flex items-center justify-center transition-all border border-slate-200 dark:border-slate-800 cursor-pointer"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg id="theme-sun-icon" class="w-4 h-4 hidden text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg id="theme-moon-icon" class="w-4 h-4 text-slate-700 dark:text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- 2. Language Toggle Pill (Default English) -->
      <div class="flex items-center bg-slate-100 dark:bg-slate-900 p-0.5 rounded-xl border border-slate-200 dark:border-slate-800 text-xs font-bold" id="lang-switch-container">
        <button 
          type="button" 
          id="btn-lang-en" 
          class="px-2.5 py-1 rounded-lg transition-all bg-white dark:bg-slate-800 text-slate-950 dark:text-white shadow-xs cursor-pointer font-bold"
          title="English Language (Default)"
        >
          EN
        </button>
        <button 
          type="button" 
          id="btn-lang-bn" 
          class="px-2.5 py-1 rounded-lg transition-all text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white cursor-pointer font-semibold"
          title="বাংলা ভাষা"
        >
          বাং
        </button>
      </div>

      <!-- Customer Login / Profile Button -->
      <button 
        type="button" 
        id="navbar-auth-btn"
        class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-900 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 flex items-center justify-center transition-all border border-slate-200 dark:border-slate-800 cursor-pointer"
        title="Customer Login / একাউন্ট"
      >
        <svg id="navbar-auth-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span id="navbar-user-initial" class="hidden font-bold text-xs text-red-600 dark:text-red-400"></span>
      </button>

      <!-- 3. RETAIL SHOP BUTTON (MUST BE AT THE VERY FAR RIGHT!) -->
      <a 
        href="/store" 
        id="navbar-shop-btn"
        class="inline-flex items-center gap-2 bg-gradient-to-r from-red-600 via-rose-600 to-red-700 hover:from-red-700 hover:to-rose-800 text-white font-black text-xs sm:text-sm px-4 sm:px-5 py-2.5 rounded-xl shadow-md hover:shadow-red-600/30 transition-all transform hover:-translate-y-0.5 active:translate-y-0 shrink-0"
        title="Visit Retail Online Store"
      >
        <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
        </svg>
        <span class="nav-shop-label">Shop</span>
      </a>

      <!-- 4. Modern Fullscreen Hamburger Menu Trigger -->
      <button 
        type="button" 
        id="menu-toggle-btn"
        aria-label="Toggle Fullscreen Menu"
        class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-900 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 flex flex-col items-center justify-center gap-1.5 transition-all cursor-pointer border border-slate-200 dark:border-slate-800"
      >
        <span class="w-5 h-0.5 bg-slate-900 dark:bg-white rounded-full transition-all duration-300"></span>
        <span class="w-5 h-0.5 bg-slate-900 dark:bg-white rounded-full transition-all duration-300"></span>
        <span class="w-3.5 self-start ml-2.5 h-0.5 bg-slate-900 dark:bg-white rounded-full transition-all duration-300"></span>
      </button>

    </div>
  </div>
</header>

<!-- ================= FULL-SCREEN LUXURY EXECUTIVE MENU ================= -->
<div 
