---
---
<section id="guide" class="py-16 bg-slate-900 text-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-red-500/20 text-red-400 text-xs font-bold uppercase tracking-wider mb-3">
        <span>📖 জরুরি জীবন রক্ষাকারী গাইড</span>
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight">
        ফায়ার এক্সটিংগুইশার ব্যবহারের <span class="text-red-500">PASS টেকনিক</span>
      </h2>
      <p class="mt-3 text-slate-300 text-sm sm:text-base leading-relaxed">
        অগ্নি নির্বাপক যন্ত্র থাকাটাই যথেষ্ট নয়, এটি ব্যবহারের সঠিক নিয়ম জেনে রাখা প্রতিটি নাগরিকের জন্য আবশ্যক।
      </p>
    </div>

    <!-- 4 PASS Steps Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- Step 1: P -->
      <div class="rounded-2xl bg-slate-800/80 border border-slate-700/80 p-6 flex flex-col items-center text-center relative group hover:border-red-500/60 transition">
        <div class="w-16 h-16 rounded-2xl bg-red-600/20 text-red-400 border border-red-500/30 flex items-center justify-center text-2xl font-black mb-4 group-hover:scale-110 transition-transform">
          P
        </div>
        <span class="text-xs font-bold text-red-400 uppercase tracking-widest mb-1">Step 1: Pull</span>
        <h3 class="text-lg font-bold text-white mb-2">পিনটি টেনে খুলুন</h3>
        <p class="text-xs text-slate-400 leading-relaxed">
          এক্সটিংগুইশারের লিভারে থাকা প্লাস্টিক লক বা মেটাল সেফটি পিনটি এক টানে খুলে ফেলুন।
        </p>
      </div>

      <!-- Step 2: A -->
      <div class="rounded-2xl bg-slate-800/80 border border-slate-700/80 p-6 flex flex-col items-center text-center relative group hover:border-amber-500/60 transition">
        <div class="w-16 h-16 rounded-2xl bg-amber-600/20 text-amber-400 border border-amber-500/30 flex items-center justify-center text-2xl font-black mb-4 group-hover:scale-110 transition-transform">
          A
        </div>
        <span class="text-xs font-bold text-amber-400 uppercase tracking-widest mb-1">Step 2: Aim</span>
        <h3 class="text-lg font-bold text-white mb-2">গোড়ায় তাক করুন</h3>
        <p class="text-xs text-slate-400 leading-relaxed">
          আগুনের শিখায় নয়, নজলটি আগুনের মূল উৎস বা গোড়ার (Base of the fire) দিকে তাক করুন।
        </p>
      </div>

      <!-- Step 3: S -->
      <div class="rounded-2xl bg-slate-800/80 border border-slate-700/80 p-6 flex flex-col items-center text-center relative group hover:border-emerald-500/60 transition">
        <div class="w-16 h-16 rounded-2xl bg-emerald-600/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center text-2xl font-black mb-4 group-hover:scale-110 transition-transform">
          S
        </div>
        <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest mb-1">Step 3: Squeeze</span>
        <h3 class="text-lg font-bold text-white mb-2">লিভার চাপ দিন</h3>
        <p class="text-xs text-slate-400 leading-relaxed">
          নিরাপদ দূরত্বে দাঁড়িয়ে (৬-৮ ফুট) এক্সটিংগুইশারের হ্যান্ডেলটি শক্তভাবে নিচের দিকে চাপ দিন।
        </p>
      </div>

      <!-- Step 4: S -->
      <div class="rounded-2xl bg-slate-800/80 border border-slate-700/80 p-6 flex flex-col items-center text-center relative group hover:border-blue-500/60 transition">
        <div class="w-16 h-16 rounded-2xl bg-blue-600/20 text-blue-400 border border-blue-500/30 flex items-center justify-center text-2xl font-black mb-4 group-hover:scale-110 transition-transform">
          S
        </div>
        <span class="text-xs font-bold text-blue-400 uppercase tracking-widest mb-1">Step 4: Sweep</span>
        <h3 class="text-lg font-bold text-white mb-2">ডানে-বামে স্প্রে করুন</h3>
        <p class="text-xs text-slate-400 leading-relaxed">
          আগুনের গোড়ায় ঝাড়ু দেওয়ার মতো করে নজলটি ডানে ও বামে ঘুরিয়ে দ্রুত আগুন সম্পূর্ণ নিভিয়ে ফেলুন।
        </p>
      </div>

    </div>

    <!-- Detector Tip Box -->
    <div class="mt-10 rounded-2xl bg-gradient-to-r from-red-950/60 via-slate-800/80 to-slate-900/60 border border-slate-700/70 p-6 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4 text-left">
        <span class="text-4xl">💡</span>
        <div>
          <h4 class="text-base font-bold text-white">স্মোক ডিটেক্টর বসানোর নিয়ম</h4>
          <p class="text-xs text-slate-300 mt-1 max-w-2xl leading-relaxed">
            ধোঁয়া সবসময় উপরের দিকে ওঠে। তাই স্মোক ডিটেক্টর সবসময় সিলিংয়ের মাঝামাঝি স্থানে লাগান। রান্নাঘরের ধোঁয়া থেকে দূরে ডাইনিং বা বেডরুমের প্রবেশমুখে লাগানো সবচেয়ে কার্যকর।
          </p>
        </div>
      </div>
      <a 
        href="#checkout-section" 
        class="shrink-0 bg-red-600 hover:bg-red-500 text-white font-bold text-xs sm:text-sm px-6 py-3 rounded-xl transition shadow-md"
      >
        স্মোক ডিটেক্টর কিনুন
      </a>
    </div>

  </div>
</section>
