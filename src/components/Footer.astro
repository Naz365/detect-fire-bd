---
---
<footer class="bg-slate-950 text-slate-300 pt-16 pb-24 md:pb-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-slate-800">
      
      <!-- Brand & Description -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3.5">
          <div class="w-13 h-13 rounded-2xl overflow-hidden border-2 border-red-500 bg-white p-1 flex items-center justify-center shrink-0">
            <img src="/images/logo.png" alt="Detect Fire" class="w-full h-full object-contain" />
          </div>
          <div>
            <div class="text-xl sm:text-2xl font-black text-white tracking-tight">
              DETECT <span class="text-red-500">FIRE</span>
            </div>
            <div class="text-[11px] font-black text-slate-400 uppercase tracking-widest">
              Engineering BD • Fire & Life Safety
            </div>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-slate-400 max-w-sm leading-relaxed">
          Bangladesh's premier industrial and commercial life-safety engineering enterprise. NFPA, BNBC, and Civil Defense compliant solutions for factories, warehouses, and corporate complexes.
        </p>

        <!-- Social Media: Facebook Page Link -->
        <div class="pt-2 flex items-center gap-3">
          <a 
            href="https://www.facebook.com/detectfirebd" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-blue-600/20 hover:bg-blue-600 border border-blue-500/40 text-blue-400 hover:text-white px-4 py-2 rounded-xl text-xs font-bold transition-all"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <span>facebook.com/detectfirebd</span>
          </a>
        </div>
      </div>

      <!-- Quick Corporate Links -->
      <div class="space-y-3">
        <div class="text-sm font-bold text-white uppercase tracking-wider">
          Quick Links
        </div>
        <ul class="space-y-2 text-xs">
          <li><a href="/" class="hover:text-red-400 transition">Home</a></li>
          <li><a href="/#about" class="hover:text-red-400 transition">About Us</a></li>
          <li><a href="/#services" class="hover:text-red-400 transition">Engineering Services</a></li>
          <li><a href="/#projects" class="hover:text-red-400 transition">Our Projects</a></li>
          <li><a href="/#contact" class="hover:text-red-400 transition">Contact Us & Map</a></li>
          <li><a href="/store" class="hover:text-red-400 font-bold text-red-400 transition">Retail Store (COD)</a></li>
          <li><a href="/blog" class="hover:text-red-400 transition">Safety Knowledge Blog</a></li>
          <li><a href="/admin" class="hover:text-slate-400 text-slate-500 transition">Admin Portal</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div class="space-y-3">
        <div class="text-sm font-bold text-white uppercase tracking-wider">
          Contact & Hotlines
        </div>
        <div class="space-y-2.5 text-xs text-slate-400">
          <p class="flex items-start gap-2">
            <span class="text-red-500 text-sm">📍</span>
            <span>Dhaka, Bangladesh (Serving all 64 districts nationwide)</span>
          </p>
          <div class="space-y-1">
            <p class="flex items-center gap-2">
              <span class="text-emerald-500 text-sm">📱</span>
              <a href="tel:+8801914457183" class="hover:text-white font-bold font-mono text-emerald-400">+8801914457183 (Hotline & WhatsApp)</a>
            </p>
            <p class="flex items-center gap-2">
              <span class="text-slate-400 text-sm">📞</span>
              <a href="tel:+8801320580632" class="hover:text-white font-semibold font-mono">+8801320580632 (Corporate Desk)</a>
            </p>
            <p class="flex items-center gap-2">
              <span class="text-slate-400 text-sm">📞</span>
              <a href="tel:+8801320580631" class="hover:text-white font-semibold font-mono">+8801320580631 (Support Desk)</a>
            </p>
          </div>
          <p class="flex items-center gap-2">
            <span class="text-blue-500 text-sm">✉️</span>
            <span>info@detectfirebd.com</span>
          </p>
          <p class="text-[11px] text-slate-500 pt-1">
            24/7 Rapid Emergency Response & Engineering Consulting
          </p>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left text-xs text-slate-500">
      <div>
        © 2026 <b>Detect Fire Engineering BD</b>. All Rights Reserved.
      </div>
      <div class="flex items-center gap-4">
        <span>BNBC & NFPA Standards Compliant</span>
      </div>
    </div>
  </div>
</footer>
